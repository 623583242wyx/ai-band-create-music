HOST=0.0.0.0
PORT=8010
PUBLIC_BASE_URL=
OUTPUT_DIR=./output
# Symlinks inside OUTPUT_DIR (including jobs/.expired/.trash) are unsupported.
# Mount storage volumes directly at OUTPUT_DIR or its real subdirectories.
# Opt in to permanent deletion; disabled by default.
# WARNING: enabled=true + dry_run=false permanently deletes existing jobs older
# than SONG_RETENTION_DAYS at the next startup. Back up output before enabling.
# First enable dry-run, review wouldDeleteJobIds in retention.log, then set false.
# Dry-run preserves files and access; real cleanup runs at 03:00 Beijing time.
# In dry-run, lastCleanupResult=success means audit completed, not deletion.
# Before enforcing deletion, require PO sign-off and frontend contract verification.
# Retention response fields are omitted while enabled=false. Days range: 1-3650.
SONG_RETENTION_ENABLED=false
SONG_RETENTION_DRY_RUN=true
SONG_RETENTION_DAYS=3

# Docker Compose host settings (ignored by the Python application)
APP_PORT=8010
APP_UID=1000
APP_GID=1000
IMAGE_TAG=latest

# Input limits
PROMPT_MAX_CHARS=2000
REQUEST_MAX_BYTES=16384
DEFAULT_DURATION_MINUTES=2
MIN_DURATION_MINUTES=1
MAX_DURATION_MINUTES=6
MAX_CONCURRENT_GENERATIONS=1

# OpenAI-compatible LLM（展开页和 AI-talk）
LLM_API_KEY=replace_with_your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_COMPLETIONS_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2
# Combined lyrics + style response budget. Keep at least 2048; maximum 4096.
LLM_MAX_TOKENS=2048
# Qwen3/Qwen3.5 only: send chat_template_kwargs.enable_thinking=false.
LLM_DISABLE_THINKING=true

# Create 收起页的中文风格扩写 LLM（独立配置；未设置时回退到 LLM_*）
STYLE_LLM_API_KEY=
STYLE_LLM_BASE_URL=http://192.168.1.4:8000/v1
STYLE_LLM_CHAT_COMPLETIONS_URL=
STYLE_LLM_MODEL=Qwen/Qwen3.5-9B-FP8
STYLE_LLM_TIMEOUT_SECONDS=30
STYLE_LLM_TEMPERATURE=0.7
STYLE_LLM_MAX_TOKENS=2048
STYLE_LLM_RESPONSE_FORMAT=json_schema
STYLE_LLM_ENABLE_THINKING=false
STYLE_LLM_TRUST_ENV_PROXY=false
STYLE_LLM_MAX_ATTEMPTS=2

# Music generation: mock | real
MUSIC_API_MODE=mock
# Default provider when a generation request omits its provider field.
MUSIC_PROVIDER=minimax_music
MOCK_FULL_SONG_PATH=./output/mock_full.mp3
MUSIC_API_KEY=
MUSIC_API_BASE_URL=
MUSIC_GENERATE_PATH=/generate
MUSIC_STATUS_PATH=/generate/status
MUSIC_API_TIMEOUT_SECONDS=240
MUSIC_DOWNLOAD_TIMEOUT_SECONDS=120
MUSIC_POLL_INTERVAL_SECONDS=5
MUSIC_MAX_POLL_ATTEMPTS=60
MUSIC_MODEL=
MUSIC_CALLBACK_URL=

# ElevenLabs: MUSIC_API_MODE=real, MUSIC_PROVIDER=elevenlabs_music
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MUSIC_MODEL_ID=music_v2_5
ELEVENLABS_MUSIC_OUTPUT_FORMAT=pcm_44100
ELEVENLABS_CLEAR_CHINESE_VOCAL_MODE=true
ELEVENLABS_FORCE_INSTRUMENTAL=false
ELEVENLABS_BYPASS_GLOBAL_PROXY=true
# 音频参考（仅 music_v2 / music_v2_5）：low / medium / high / xhigh
ELEVENLABS_REFERENCE_CONDITION_STRENGTH=medium
AUDIO_REFERENCE_MAX_UPLOAD_MB=30

# Suno sidecar: MUSIC_API_MODE=real, MUSIC_PROVIDER=suno_api
SUNO_CREATE_TIMEOUT_SECONDS=180
SUNO_MAKE_INSTRUMENTAL=false
SUNO_MODEL=v4.5-all
SUNO_MODEL_FALLBACKS=
SUNO_USE_DEFAULT_MODEL_FALLBACKS=false

# Self-hosted MiniMax Music 3: MUSIC_API_MODE=real, MUSIC_PROVIDER=minimax_music
# Lyrics are written using LLM_*; generation calls the local /v1/audio/jobs service.
MINIMAX_BASE_URL=http://192.168.1.4:8111
MINIMAX_MODEL=MiniMaxAI/MiniMax-Music3
MINIMAX_SEED=42
MINIMAX_NUM_INFERENCE_STEPS=30
MINIMAX_TIMEOUT_SECONDS=7200

# Mureka: MUSIC_API_MODE=real, MUSIC_PROVIDER=mureka_music
# 模型与价格见 https://platform.mureka.ai/pricing（mureka-9.5 / mureka-9 / mureka-8 / mureka-o2）
MUREKA_API_KEY=
MUREKA_BASE_URL=https://api.mureka.ai
MUREKA_MODEL=mureka-9.5
MUREKA_TIMEOUT_SECONDS=900
MUREKA_BYPASS_GLOBAL_PROXY=true

# BS-RoFormer-SW six-stem separation
BS_ROFORMER_DEVICE=cuda
BS_ROFORMER_MODELS_DIR=./output/.bs-roformer-models
BS_ROFORMER_TIMEOUT_SECONDS=1800

# Track-page recording uploads (maximum duration follows MAX_DURATION_MINUTES).
RECORDING_MAX_UPLOAD_MB=50

# RVC voice conversion. All assets and results live inside generate_module.
RVC_MODEL_PATH=./assets/rvc/weights/9971-700.pth
RVC_INDEX_PATH=./assets/rvc/indices/9971-700_added_IVF2037_Flat_nprobe_1_9971-700_v2.index
RVC_BASE_MODEL_DIR=./assets/rvc/base_model
RVC_MODEL_VERSION=v2
RVC_DEVICE=cuda:0
RVC_CPU_THREADS=6
RVC_MAX_UPLOAD_MB=50
RVC_CONVERSION_TIMEOUT_SECONDS=1800
RVC_MIX_TIMEOUT_SECONDS=180

# Reserved infrastructure hooks. Local mode does not require Redis or a queue.
TASK_BACKEND=inline
CACHE_BACKEND=none
EVENT_BACKEND=none
# REDIS_URL=redis://localhost:6379/0
# QUEUE_NAME=ai-music-generation
# CACHE_DEFAULT_TTL_SECONDS=3600

# CORS: comma-separated origins, or * for local compatibility
CORS_ORIGINS=*
